# Copy to .env.local. CSV sending does not use a database.

# Unlocks POST /send. At least 16 characters. openssl rand -base64 24
SEND_SECRET=replace-with-a-long-random-string

# Resend API key (Sending access). Required to deliver mail.
RESEND_API_KEY=re_xxxxxxxxx

# From header. Until a domain is verified, keep the Resend test sender.
# Test mail is delivered only to the inbox on the Resend account.
MAIL_FROM=Reichman Entrepreneurship Club <onboarding@resend.dev>

# --- Not used by CSV sending (kept for a later database) ---
# APP_URL=http://localhost:3000
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
